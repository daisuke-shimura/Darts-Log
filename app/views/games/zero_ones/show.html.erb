<div class="position-relative" data-controller="board-logic--zero-one target"
  data-target-selector='[data-board-logic--zero-one-target="targetInput"]'
  data-board-logic--zero-one-game-id-value="<%= @game.id %>" 
  data-current-score="<%= @current_score %>" 
  data-round="<%= @round_number %>">
  <div class="board position-absolute top-0 ms-2" data-action="click->board-logic--zero-one#click">
    <% cache "dartboard" do %>
      <%= render "records/board/out" %>
      <%= render "records/board/double" %>
      <%= render "records/board/outer-single" %>
      <%= render "records/board/triple" %>
      <%= render "records/board/inner-single" %>
      <%= render "records/board/bull" %>
    <% end %>
  </div>

  <%= render "records/result", js_controller: "board-logic--zero-one" %>
  
  <%= render "records/modal-target-form" %>

  <div class="position-fixed top-0 end-0 mt-5 p-1">
    <div class="round-box ms-auto" data-board-logic--zero-one-target="roundBox">
      <% [@rounds.size + 2, 20].max.times do |n| %>
        <div class="d-flex">
          <span class="ps-1 round-label">R<%= n + 1 %></span>
          <span class="pe-2 round-score <%= round_text_class(@rounds[n]) %>" data-board-logic--zero-one-target="roundScore">
            <%= @rounds[n]&.bust ? "BUST" : (@rounds[n]&.score || "-") %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</div>
