<div
  class="d-flex flex-column justify-content-center align-items-center position-relative overflow-hidden"
  style="
    min-height: 100vh;
    padding: 2rem;
    background:
      linear-gradient(
        to bottom,
        #3b0d12 0%,
        #1a0b0d 30%,
        #090909 70%,
        #000000 100%
      );
  "
>

  <div
    class="position-absolute top-0 start-0 w-100"
    style="
      height: 6px;
      background:
        linear-gradient(
          90deg,
          #ff6b81,
          #dc3545,
          #ff6b81
        );
      box-shadow:
        0 0 20px #dc3545;
    "
  ></div>

  <div class="text-center mb-5">
    <h1
      class="fw-bold text-white m-0"
      style="
        font-size: clamp(3rem, 10vw, 5rem);
        letter-spacing: .18em;

        text-shadow:
          0 0 10px #ff6b81,
          0 0 30px #dc3545,
          0 0 60px #dc3545;
      "
    >
      01 GAMES
    </h1>
  </div>

  <%= form_with url: games_path, method: :post, class: "w-100 d-flex justify-content-center" do |f| %>

    <%= hidden_field_tag :kind, "zero_one" %>

    <div style="width: min(560px, 100%);">
      <div class="option-title">
        START SCORE
      </div>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-5">
        <% [301, 501, 701, 901, 1101, 1501].each do |score| %>
          <div class="col">
            <input
              type="radio"
              class="btn-check"
              name="start_score"
              id="score_<%= score %>"
              value="<%= score %>"
              autocomplete="off"
              required
            >
            <label
              class="score-card w-100"
              for="score_<%= score %>"
            >
              <span><%= score %></span>
            </label>
          </div>
        <% end %>
      </div>

      <div class="option-section">
        <div class="option-title">
          GAME OPTIONS
        </div>

        <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
          <div class="col">
            <%= f.check_box :separate_bull,
              class: "btn-check",
              autocomplete: "off" %>

            <%= f.label :separate_bull, class: "option-card w-100" do %>
              <span class="option-check">✓</span>
              <span>セパレートブル</span>
            <% end %>
          </div>

          <div class="col">
            <%= f.check_box :master_out,
              class: "btn-check",
              autocomplete: "off" %>

            <%= f.label :master_out, class: "option-card w-100" do %>
              <span class="option-check">✓</span>
              <span>マスターアウト</span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="d-grid">
        <%= f.button type: :submit,
          class: "
            btn
            rounded-pill
            fw-bold
            border-0
            start-button
          " do %>
          START
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<style>
  .score-card {
    height: 92px;
    border-radius: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: .08em;
    color: rgba(255,255,255,.82);
    border: 1.5px solid rgba(220,53,69,.55);
    background:
      linear-gradient(
        145deg,
        rgba(220,53,69,.16),
        rgba(255,255,255,.02)
      );
    backdrop-filter: blur(10px);
    box-shadow:
      0 0 12px rgba(220,53,69,.12),
      inset 0 1px 1px rgba(255,255,255,.08),
      0 10px 30px rgba(0,0,0,.45);
    transition:
      transform .15s ease,
      border-color .15s ease,
      box-shadow .15s ease,
      color .15s ease,
      background .15s ease;
  }

  .score-card:hover {
    transform: translateY(-3px);
    color: white;
    border-color:rgba(255,107,129,.9);
    box-shadow:
      0 0 20px rgba(220,53,69,.32),
      0 0 50px rgba(220,53,69,.18),
      0 12px 40px rgba(0,0,0,.45);
  }

  .btn-check:checked + .score-card {
    color: white;
    border-color:rgba(255,107,129,1);
    background:
      linear-gradient(
        145deg,
        rgba(220,53,69,.5),
        rgba(120,0,0,.35)
      );
    box-shadow:
      0 0 20px rgba(220,53,69,.5),
      0 0 60px rgba(220,53,69,.3),
      inset 0 1px 1px rgba(255,255,255,.25);
    transform: scale(1.03);
  }

  .start-button {
    --main-color: #dc3545;
    --sub-color: #ff6b81;
    height: 72px;
    font-size: 1.3rem;
    letter-spacing: .25em;
    color: white;
    background: linear-gradient(135deg, var(--main-color), var(--sub-color));
    box-shadow:
      0 0 20px color-mix(in srgb, var(--main-color) 60%, transparent),
      0 0 40px color-mix(in srgb, var(--main-color) 35%, transparent),
      inset 0 1px 1px rgba(255,255,255,.3);
    transition:
      transform .15s ease,
      box-shadow .15s ease,
      filter .15s ease;
    position: relative;
    overflow: hidden;
  }

  .start-button:hover {
    color: white;
    transform: scale(1.05);
    box-shadow:
      0 0 30px color-mix(in srgb, var(--main-color) 90%, transparent),
      0 0 60px color-mix(in srgb, var(--main-color) 60%, transparent),
      0 0 100px color-mix(in srgb, var(--main-color) 35%, transparent),
      inset 0 1px 1px rgba(255,255,255,.4);
  }

  .start-button:active {
    transform: scale(.98);
  }

  .start-button::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        120deg,
        transparent 20%,
        rgba(255,255,255,.25) 50%,
        transparent 80%
      );
    transform: translateX(-120%);
    transition: transform .4s ease;
  }

  .start-button:hover::before {
    transform: translateX(120%);
  }

  .option-section {
    margin-bottom: 2rem;
  }

  .option-title {
    margin-bottom: .75rem;
    padding-left: .5rem;
    color: rgba(255, 255, 255, .55);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .option-card {
    min-height: 64px;
    padding: 0 1.25rem;
    border-radius: 1rem;
    display: flex;
    align-items: center;
    gap: .75rem;
    cursor: pointer;

    color: rgba(255, 255, 255, .72);
    font-size: 1rem;
    font-weight: 700;

    border: 1.5px solid rgba(220, 53, 69, .35);

    background:
      linear-gradient(
        145deg,
        rgba(220, 53, 69, .10),
        rgba(255, 255, 255, .02)
      );

    box-shadow:
      0 0 10px rgba(220, 53, 69, .08),
      inset 0 1px 1px rgba(255, 255, 255, .05);

    transition:
      transform .15s ease,
      border-color .15s ease,
      box-shadow .15s ease,
      color .15s ease,
      background .15s ease;
  }

  .option-card:hover {
    transform: translateY(-2px);
    color: white;
    border-color: rgba(255, 107, 129, .7);

    box-shadow:
      0 0 18px rgba(220, 53, 69, .25),
      0 10px 25px rgba(0, 0, 0, .35);
  }

  .btn-check:checked + .option-card {
    color: white;

    border-color: rgba(255, 107, 129, 1);

    background:
      linear-gradient(
        145deg,
        rgba(220, 53, 69, .42),
        rgba(120, 0, 0, .25)
      );

    box-shadow:
      0 0 18px rgba(220, 53, 69, .45),
      0 0 45px rgba(220, 53, 69, .2),
      inset 0 1px 1px rgba(255, 255, 255, .2);
  }

  .option-check {
    width: 22px;
    height: 22px;
    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    color: transparent;
    font-size: .8rem;
    font-weight: 900;

    border: 1.5px solid rgba(255, 255, 255, .25);

    transition:
      color .15s ease,
      background .15s ease,
      border-color .15s ease,
      box-shadow .15s ease;
  }

  .btn-check:checked + .option-card .option-check {
    color: white;
    border-color: #ff6b81;
    background: #dc3545;

    box-shadow:
      0 0 10px rgba(220, 53, 69, .8),
      0 0 20px rgba(220, 53, 69, .4);
  }
</style>
