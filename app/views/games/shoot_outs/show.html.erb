<div class="position-relative" data-controller="board-logic--shoot-out target"
  data-target-selector='[data-board-logic--shoot-out-target="targetInput"]'
  data-board-logic--shoot-out-game-id-value="<%= @game.id %>" 
  data-current-score="<%= @current_score %>"
  data-current-status="<%= @current_segments_status.to_json %>"
  data-round="<%= @round_number %>">
  <div class="board position-absolute top-0 ms-2" data-action="click->board-logic--shoot-out#click">
    <% cache "dartboard" do %>
      <%= render "records/board/out" %>
      <%= render "records/board/double" %>
      <%= render "records/board/outer-single" %>
      <%= render "records/board/triple" %>
      <%= render "records/board/inner-single" %>
      <%= render "records/board/bull" %>
    <% end %>
  </div>

  <%= render "records/result", js_controller: "board-logic--shoot-out" %>
  
  <%= render "records/modal-target-form" %>

  <div class="position-fixed top-0 end-0 mt-5 p-1">
    <div class="score-box" data-board-logic--shoot-out-target="scoreBox">
      <%= @current_score %>
    </div>
    <div class="round-box mt-2 ms-auto" data-board-logic--shoot-out-target="roundBox">
      <% [@rounds.size, 8].max.times do |n| %>
        <div class="d-flex">
          <span class="ps-1 round-label">R<%= n + 1 %></span>
          <span class="pe-2 round-score <%= round_text_class(@rounds[n]) %>" data-board-logic--shoot-out-target="roundScore">
            <%= @rounds[n]&.score || "-" %>
          </span>
        </div>
      <% end %>
    </div>
    <div class="d-flex justify-content-end mt-2">
      <div class="bg-black text-white rounded w-50 px-2 py-2 d-flex align-items-center">
        <div class="d-flex flex-column align-items-center lh-1 me-3">
          <small class="mb-1">NEXT</small>
          <span class="fw-bold fs-5">×</span>
        </div>
        <span class="fw-bold lh-1 fs-2" data-board-logic--shoot-out-target="currentRate"><%= @rate %></span>
      </div>
    </div>
  </div>
</div>
