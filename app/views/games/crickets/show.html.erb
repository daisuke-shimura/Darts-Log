<div class="position-relative" 
  data-controller="board-logic--cricket target"
  data-board-logic--cricket-game-id-value="<%= @game.id %>"
  data-current-score="<%= @current_segments_status.to_json %>"
  data-round="<%= @round_number %>">
  <div class="board position-absolute top-0 ms-2" data-action="click->board-logic--cricket#click">
    <% cache "dartboard" do %>
      <%= render "records/board/out" %>
      <%= render "records/board/double" %>
      <%= render "records/board/outer-single" %>
      <%= render "records/board/triple" %>
      <%= render "records/board/inner-single" %>
      <%= render "records/board/bull" %>
    <% end %>
  </div>

  <%= render "records/result", js_controller: "board-logic--cricket" %>
  
  <%= render "records/modal-target-form" %>

  <div class="position-fixed top-0 end-0 mt-5 p-1">
    <div class="cricket-box d-flex justify-content-between">
      <div class="number-box">
        <div class="cricket-label">20</div>
        <div class="cricket-label">19</div>
        <div class="cricket-label">18</div>
        <div class="cricket-label">17</div>
        <div class="cricket-label">16</div>
        <div class="cricket-label">15</div>
        <div class="cricket-label fs-6">BULL</div>
      </div>
      <div class="mark-box" data-board-logic--cricket-target="marksBox">
        <% @current_segments_status.each do |number, mark| %>
          <div class="cricket-mark" data-cricketrow="<%= number %>">
            <%= cricket_mark(mark) %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="round-box mt-2 ms-auto" data-board-logic--cricket-target="roundBox">
      <% [@round_marks.size, 10].max.times do |r| %>
      <div class="d-flex">
        <span class="ps-1 round-label">R<%= r + 1 %></span>
        <span class="round-mark" data-board-logic--cricket-target="roundScore">
          <% if @round_marks[r].present? %>
            <span><%= cricket_mark(@round_marks[r][0]) %></span>
            <span><%= cricket_mark(@round_marks[r][1]) %></span>
            <span><%= cricket_mark(@round_marks[r][2]) %></span>
          <% else %>
            <span></span>
            <span></span>
            <span></span>
          <% end %>
        </span>
      </div>
      <% end %>
    </div>
  </div>
</div>
