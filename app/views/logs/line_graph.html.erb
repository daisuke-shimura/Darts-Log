<div style="width: 90%; margin: 0 auto;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <p class="fw-bold fs-5">折れ線グラフ用ページ</p>

    <div>
      Rounds：<%= @recent_rounds.count %>回
      <button
        class="btn btn-outline-secondary"
        data-bs-toggle="offcanvas"
        data-bs-target="#filterPanel"
      >
        Filter
        <% if params[:day_from].present? || params[:day_to].present? %>
          <span class="badge text-bg-secondary">
            <%= date_range(params[:day_from], params[:day_to]) %>
          </span>
        <% end %>

        <% if params[:recent].present? %>
          <span class="badge text-bg-secondary">
            <%= params[:recent] %> 回
          </span>
        <% end %>
      </button>
    </div>
  </div>

  <div
    class="mb-5"
    data-controller="log-logic--line-graph"
    data-log-logic--line-graph-labels-value="<%= @line_labels.to_json %>"
    data-log-logic--line-graph-graph-data-value="<%= @graph_data.to_json %>"
  >

    <div class="d-flex gap-3 mb-3">

      <% @graph_data.each do |graph| %>
        <div class="form-check">

          <input
            class="form-check-input"
            type="checkbox"
            checked
            data-log-logic--line-graph-target="checkbox"
            data-action="change->log-logic--line-graph#toggleGraph"
          >

          <label class="form-check-label">
            <%= graph[:label] %>
          </label>

        </div>
      <% end %>

    </div>

    <canvas
      data-log-logic--line-graph-target="canvas">
    </canvas>

  </div>
</div>

<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="filterPanel"
>

  <div class="offcanvas-header">
    <h5>Filter</h5>

    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas">
    </button>
  </div>

  <div class="offcanvas-body">
    <%= form_with url: logs_line_graph_path,
                method: :get,
                local: true do %>
      <div class="card border-light mb-2">
        <div class="card-body py-2">

          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-semibold text-secondary">Day</span>

            <div class="d-flex gap-1 flex-wrap">
              <% if params[:day_from].present? || params[:day_to].present? %>
                <span class="badge text-bg-secondary">
                  <%= date_range(params[:day_from], params[:day_to]) %>
                </span>
              <% end %>

              <% if params[:recent].present? %>
                <span class="badge text-bg-secondary">
                  <%= params[:recent] %> 本
                </span>
              <% end %>
            </div>
          </div>

          <div class="row g-2 align-items-center">
            <div class="col-auto">
              <div class="d-flex align-items-center gap-1">
                <%= date_field_tag :day_from,
                      params[:day_from],
                      class: "form-control form-control-sm",
                      style: "width: 108px;" %>

                <span>～</span>

                <%= date_field_tag :day_to,
                      params[:day_to],
                      class: "form-control form-control-sm",
                      style: "width: 108px;" %>
              </div>
            </div>

            <div class="col-auto">
              <div class="input-group input-group-sm">
                <%= number_field_tag :recent,
                      params[:recent],
                      min: 1,
                      class: "form-control",
                      style: "width: 90px;" %>

                <span class="input-group-text">本</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <%= link_to "リセット", logs_line_graph_path, class: "btn btn-light border text-secondary" %>
        <%= submit_tag "絞り込み", class: "btn btn-primary", name: nil %>
      </div>
    <% end %>
  </div>
</div>
