<div class="position-relative bg-light" style="height: 100vh;">
  <p>折れ線グラフ用ページ</p>
  <div style="width: 80%; margin: 0 auto;">
    <canvas data-controller="line-graph"
            data-line-graph-labels-value="<%= @line_labels.to_json %>"
            data-line-graph-data-value="<%= @line_data.to_json %>">
