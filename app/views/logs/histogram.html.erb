<div style="width: 80%; margin: 0 auto;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <p class="fw-bold fs-5">ヒストグラム用ページ</p>

    <div>
      <!-- ▼ 選択されているモードに合わせて単位（本/R）を切り替え ▼ -->
      <span class="me-3 fw-semibold">
        <% if @data_type == "rounds" %>
          Rounds：<%= @recent_rounds&.count || 0 %>R
        <% else %>
          Darts：<%= @darts&.count || 0 %>本
        <% end %>
      </span>

      <button
        class="btn btn-outline-secondary"
        data-bs-toggle="offcanvas"
        data-bs-target="#filterPanel"
      >
        Filter
        
        <!-- ▼ モード別のバッジ表示 ▼ -->
        <% if @data_type == "rounds" %>
          <span class="badge text-bg-success">
            <%= { "hit" => "BULL数", "distance" => "平均距離", "gravity_r" => "重心のズレ", "variance_x" => "X分散", "variance_y" => "Y分散" }[params[:metric] || "hit"] %>
          </span>
        <% else %>
          <% if params[:histogram_mode].present? || @histogram_modes.present? %>
            <span class="badge text-bg-primary">
              <%= @histogram_modes[(params[:histogram_mode] || "range").to_sym] %>
            </span>
          <% end %>
        <% end %>

        <% if params[:day_from].present? || params[:day_to].present? %>
          <span class="badge text-bg-secondary">
            <%= date_range(params[:day_from], params[:day_to]) %>
          </span>
        <% end %>

        <% if params[:recent].present? %>
          <span class="badge text-bg-secondary">
            <%= params[:recent] %> <%= @data_type == "rounds" ? "R" : "本" %>
          </span>
        <% end %>
      </button>
    </div>
  </div>

  <canvas data-controller="log-logic--histogram"
          data-log-logic--histogram-labels-value="<%= @bar_labels.to_json %>"
          data-log-logic--histogram-data-value="<%= @bar_data.to_json %>">
  </canvas>
</div>

<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="filterPanel"
>
  <div class="offcanvas-header">
    <h5>Filter</h5>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas">
    </button>
  </div>

  <div class="offcanvas-body">
    <%= form_with url: logs_histogram_path,
                method: :get,
                local: true do %>

      <!-- ▼ 追加：分析モードの切り替えセクション ▼ -->
      <div class="card border-light mb-3">
        <div class="card-header bg-transparent fw-semibold text-secondary pb-0 border-0">
          分析モード
        </div>
        <div class="card-body py-2">
          
          <!-- モード1: ダーツ1本ごとの分布 -->
          <div class="form-check mb-3">
            <%= radio_button_tag :data_type, "darts", @data_type == "darts" || @data_type.blank?, class: "form-check-input", id: "mode_darts" %>
            <%= label_tag :mode_darts, "1本ごとの着弾分布", class: "form-check-label fw-bold" %>
            
            <div class="mt-2 ms-2">
              <%= select_tag :histogram_mode,
                  options_for_select(
                    @histogram_modes.invert,
                    params[:histogram_mode]&.to_sym || :range
                  ), class: "form-select form-select-sm" 
              %>
            </div>
          </div>

          <hr class="text-secondary opacity-25">

          <!-- モード2: ラウンドごとの分布 -->
          <div class="form-check mt-3">
            <%= radio_button_tag :data_type, "rounds", @data_type == "rounds", class: "form-check-input", id: "mode_rounds" %>
            <%= label_tag :mode_rounds, "ラウンドごとの成績分布", class: "form-check-label fw-bold" %>
            
            <div class="mt-2 ms-2">
              <%= select_tag :metric,
                  options_for_select([
                    ["BULL数 (安定感)", "hit"], 
                    ["平均距離 (グルーピング力)", "distance"], 
                    ["重心のズレ (コントロール力)", "gravity_r"],
                    ["X分散 (横ブレの大きさ)", "variance_x"],
                    ["Y分散 (縦ブレの大きさ)", "variance_y"] 
                  ], params[:metric] || "hit"), 
                  class: "form-select form-select-sm" 
              %>
            </div>
          </div>

        </div>
      </div>
      <!-- ▲ 追加ここまで ▲ -->

      <!-- 既存のDayフィルター -->
      <div class="card border-light mb-3">
        <div class="card-body py-2">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-semibold text-secondary">Day</span>

            <div class="d-flex gap-1 flex-wrap">
              <% if params[:day_from].present? || params[:day_to].present? %>
                <span class="badge text-bg-secondary">
                  <%= date_range(params[:day_from], params[:day_to]) %>
                </span>
              <% end %>

              <% if params[:recent].present? %>
                <span class="badge text-bg-secondary">
                  <%= params[:recent] %> <%= @data_type == "rounds" ? "R" : "本" %>
                </span>
              <% end %>
            </div>
          </div>

          <div class="row g-2 align-items-center">
            <div class="col-auto">
              <div class="d-flex align-items-center gap-1">
                <%= date_field_tag :day_from,
                      params[:day_from],
                      class: "form-control form-control-sm",
                      style: "width: 108px;" %>
                <span>～</span>
                <%= date_field_tag :day_to,
                      params[:day_to],
                      class: "form-control form-control-sm",
                      style: "width: 108px;" %>
              </div>
            </div>

            <div class="col-auto">
              <div class="input-group input-group-sm">
                <%= number_field_tag :recent,
                      params[:recent],
                      min: 1,
                      class: "form-control",
                      style: "width: 90px;" %>
                <span class="input-group-text"><%= @data_type == "rounds" ? "R" : "本" %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <%= link_to "リセット", logs_histogram_path, class: "btn btn-light border text-secondary" %>
        <%= submit_tag "絞り込み", class: "btn btn-primary", name: nil %>
      </div>
    <% end %>
  </div>
</div>
