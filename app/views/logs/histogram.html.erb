<div style="width: 80%; margin: 0 auto;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <p class="fw-bold fs-5">ヒストグラム用ページ</p>
    
    <%= form_with url: logs_histogram_path, method: :get, local: true do %>
      <div class="d-flex gap-2">
        <%= select_tag :histogram_mode,
            options_for_select([
              ["幅43", "range"],
              ["実値", "exact"],
              ["実値（R）", "exact_r"]
            ], params[:histogram_mode]),
            class: "form-select form-select-sm" 
        %>
        <%= submit_tag "切り替え", class: "btn btn-primary btn-sm", name: nil %>
      </div>
    <% end %>
  </div>

  <canvas data-controller="log-logic--histogram"
          data-log-logic--histogram-labels-value="<%= @bar_labels.to_json %>"
          data-log-logic--histogram-data-value="<%= @bar_data.to_json %>">
  </canvas>
</div>
