<div class="position-relative bg-light" style="height: 100vh;">
  <div class="d-flex justify-content-between align-items-center mb-3" style="width: 80%; margin: 4px auto;">
    <p class="fw-bold fs-5">ヒストグラム用ページ</p>
    
    <%= form_with url: logs_histogram_path, method: :get, local: true do %>
      <div class="d-flex gap-2">
        <%= select_tag :histogram_mode,
            options_for_select([
              ["幅43", "range"],
              ["実値", "exact"]
            ], params[:histogram_mode]),
            class: "form-select form-select-sm" 
        %>
        <%= submit_tag "切り替え", class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </div>

  <div style="width: 80%; margin: 0 auto;">
    <canvas data-controller="histogram"
            data-histogram-labels-value="<%= @bar_labels.to_json %>"
            data-histogram-data-value="<%= @bar_data.to_json %>">
    </canvas>
  </div>
</div>

<div class="position-fixed bottom-0 end-0">
  <%= render "switching_btn" %>
</div>
