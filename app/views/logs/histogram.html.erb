<div style="width: 80%; margin: 0 auto;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <p class="fw-bold fs-5">ヒストグラム用ページ</p>

    <button
      class="btn btn-outline-secondary"
      data-bs-toggle="offcanvas"
      data-bs-target="#filterPanel"
    >
      Filter
      <% if params[:histogram_mode].present? %>
        <span class="badge text-bg-primary">
          <%= @histogram_modes[params[:histogram_mode].to_sym] %>
        </span>
      <% end %>

      <% if params[:day_from].present? || params[:day_to].present? %>
        <span class="badge text-bg-secondary">
          <%= short_date(params[:day_from]) %> ～ <%= short_date(params[:day_to]) %>
        </span>
      <% end %>

      <% if params[:recent].present? %>
        <span class="badge text-bg-secondary">
          <%= params[:recent] %> 本
        </span>
      <% end %>
    </button>
  </div>

  <canvas data-controller="log-logic--histogram"
          data-log-logic--histogram-labels-value="<%= @bar_labels.to_json %>"
          data-log-logic--histogram-data-value="<%= @bar_data.to_json %>">
  </canvas>
</div>

<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="filterPanel"
>

  <div class="offcanvas-header">
    <h5>Filter</h5>

    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas">
    </button>
  </div>

  <div class="offcanvas-body">
    <%= form_with url: logs_histogram_path,
                method: :get,
                local: true do %>

      <div class="card border-light mb-2">
        <%= select_tag :histogram_mode,
            options_for_select(
              @histogram_modes.invert,
              params[:histogram_mode]&.to_sym
            ), class: "form-select form-select-sm" 
        %>
      </div>

      <div class="card border-light mb-2">
        <div class="card-body py-2">

          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-semibold text-secondary">Day</span>

            <div class="d-flex gap-1 flex-wrap">
              <% if params[:day_from].present? || params[:day_to].present? %>
                <span class="badge text-bg-secondary">
                  <%= short_date(params[:day_from]) %> ～ <%= short_date(params[:day_to]) %>
                </span>
              <% end %>

              <% if params[:recent].present? %>
                <span class="badge text-bg-secondary">
                  <%= params[:recent] %> 本
                </span>
              <% end %>
            </div>
          </div>

          <div class="row g-2 align-items-center">
            <div class="col-auto">
              <div class="d-flex align-items-center gap-1">
                <%= date_field_tag :day_from,
                      params[:day_from],
                      class: "form-control form-control-sm",
                      style: "width: 108px;" %>

                <span>～</span>

                <%= date_field_tag :day_to,
                      params[:day_to],
                      class: "form-control form-control-sm",
                      style: "width: 108px;" %>
              </div>
            </div>

            <div class="col-auto">
              <div class="input-group input-group-sm">
                <%= number_field_tag :recent,
                      params[:recent],
                      min: 1,
                      class: "form-control",
                      style: "width: 90px;" %>

                <span class="input-group-text">本</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <%= link_to "リセット", logs_histogram_path, class: "btn btn-light border text-secondary" %>
        <%= submit_tag "絞り込み", class: "btn btn-primary", name: nil %>
      </div>
    <% end %>
  </div>
</div>
