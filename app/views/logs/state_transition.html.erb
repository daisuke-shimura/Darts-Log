<div class="container-fluid py-4 px-lg-5">
  <p class="fw-bold fs-5">状態遷移図</p>
  
  <div class="row mb-5">
    <div class="col-12 d-flex justify-content-center overflow-auto">
      <svg width="800" height="600" viewBox="0 -100 800 700">
        <defs>
          <% arrow_marker_colors.each do |id, color| %>
            <marker id="<%= id %>" viewBox="0 0 10 10" refX="40" refY="5" markerWidth="10" markerHeight="10" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="<%= color %>" />
            </marker>
          <% end %>
        </defs>

        <% @transitions.each do |(from, to), count| %>
          <% next if count == 0 %>
          <% style = transition_style(count, @max_transition, @second_max_transition) %>
          <% 
            attrs = if from == to
                      loop_path_attributes(@positions[from])
                    else
                      transition_path_attributes(@positions[from], @positions[to])
                    end
          %>

          <path
            d="<%= attrs[:d] %>"
            fill="none" 
            stroke="<%= style[:color] %>" 
            stroke-width="<%= style[:width] %>" 
            marker-end="url(#<%= style[:marker_id] %>)"
          />
          
          <circle cx="<%= attrs[:text_x] %>" cy="<%= attrs[:text_y] %>" r="12" fill="white" stroke="#888" opacity="1.0" />
          <text x="<%= attrs[:text_x] %>" y="<%= attrs[:text_y] %>" font-size="14" fill="#333" text-anchor="middle" dominant-baseline="middle" font-weight="bold">
            <%= count %>
          </text>
        <% end %>

        <% @positions.each do |state, pos| %>
          <circle
            cx="<%= pos[:x] %>"
            cy="<%= pos[:y] %>"
            r="30"
            fill="white"
            stroke="#333"
            stroke-width="2"
          />
          <text
            x="<%= pos[:x] %>"
            y="<%= pos[:y] %>"
            font-size="16"
            font-weight="bold"
            fill="#333"
            text-anchor="middle"
            dominant-baseline="middle"
          >
            <%= state %>
          </text>
        <% end %>

        <% legend_data = transition_legend(@max_transition, @second_max_transition) %>
        <% if legend_data.any? %>
          <g transform="translate(680, -80)">
            <rect x="0" y="0" width="110" height="<%= legend_data.size * 25 + 40 %>" fill="white" stroke="#e2e8f0" stroke-width="2" rx="8" />
            
            <text x="55" y="22" font-size="12" font-weight="bold" fill="#64748b" text-anchor="middle">遷移回数</text>
            
            <% legend_data.each_with_index do |item, index| %>
              <rect x="15" y="<%= 35 + index * 25 %>" width="16" height="16" fill="<%= item[:color] %>" rx="4" />
              <text x="40" y="<%= 48 + index * 25 %>" font-size="13" fill="#333" font-weight="bold"><%= item[:text] %></text>
            <% end %>
          </g>
        <% end %>
      </svg>
    </div>
  </div>

  <div class="row row-cols-1 row-cols-lg-2 g-4">
    
    <div class="col">
      <h5 class="fw-bold text-dark mb-3">状態数</h5>
      <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
          <thead class="table-light">
            <tr>
              <th scope="col">状態</th>
              <th scope="col">回数</th>
            </tr>
          </thead>
          <tbody>
            <% @patterns.each do |state, count| %>
              <tr>
                <td><%= state %></td>
                <td><%= count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="col">
      <h5 class="fw-bold text-dark mb-3">状態遷移図（データ）</h5>
      <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-nowrap">遷移元 ↓ / 遷移先 →</th>
              <% @states.each do |to_state| %>
                <th scope="col"><%= to_state %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @states.each do |from_state| %>
              <tr>
                <th scope="row" class="table-light"><%= from_state %></th>
                
                <% @states.each do |to_state| %>
                  <td>
                    <%= @transitions[[from_state, to_state]] %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
