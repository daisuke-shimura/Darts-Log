<div class="container-fluid py-4 px-5 position-relative">
  <div
    class="position-absolute top-0 start-50 translate-middle-x d-flex justify-content-between align-items-center"
    style="width: 80%;"
  >
    <p class="fw-bold fs-5">状態遷移図</p>

    <button
      class="btn btn-outline-secondary"
      data-bs-toggle="offcanvas"
      data-bs-target="#filterPanel"
    >
      Filter
      <% if params[:day_from].present? || params[:day_to].present? %>
        <span class="badge text-bg-secondary">
          <%= short_date(params[:day_from]) %> ～ <%= short_date(params[:day_to]) %>
        </span>
      <% end %>

      <% if params[:recent].present? %>
        <span class="badge text-bg-secondary">
          <%= params[:recent] %> 本
        </span>
      <% end %>
    </button>
  </div>
  
  <div class="row mb-5" data-controller="log-logic--state-transition">
    <div class="col-12 d-flex justify-content-center overflow-auto">
      <svg width="800" height="600" viewBox="0 -50 800 700">
        <defs>
          <% arrow_marker_colors.each do |id, color| %>
            <marker id="<%= id %>" viewBox="0 0 10 10" refX="40" refY="5" markerWidth="10" markerHeight="10" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="<%= color %>" />
            </marker>
          <% end %>
        </defs>

        <% @transitions.each do |(from, to), count| %>
          <% next if count == 0 %>
          <% style = transition_style(count, @max_transition, @second_max_transition) %>
          <% 
            attrs = if from == to
                      loop_path_attributes(@positions[from])
                    else
                      transition_path_attributes(@positions[from], @positions[to])
                    end
          %>
          <g class="transition-<%= style[:marker_id] %>">
            <path
              d="<%= attrs[:d] %>"
              fill="none" 
              stroke="<%= style[:color] %>" 
              stroke-width="<%= style[:width] %>" 
              marker-end="url(#<%= style[:marker_id] %>)"
            />
            
            <circle cx="<%= attrs[:text_x] %>" cy="<%= attrs[:text_y] %>" r="12" fill="white" stroke="#888" opacity="1.0" />
            <text x="<%= attrs[:text_x] %>" y="<%= attrs[:text_y] %>" font-size="14" fill="#333" text-anchor="middle" dominant-baseline="middle" font-weight="bold">
              <%= count %>
            </text>
          </g>
        <% end %>

        <% @positions.each do |state, pos| %>
          <circle
            cx="<%= pos[:x] %>"
            cy="<%= pos[:y] %>"
            r="30"
            fill="white"
            stroke="#333"
            stroke-width="2"
          />
          <text
            x="<%= pos[:x] %>"
            y="<%= pos[:y] %>"
            font-size="16"
            font-weight="bold"
            fill="#333"
            text-anchor="middle"
            dominant-baseline="middle"
          >
            <%= state %>
          </text>
        <% end %>

        <% legend_data = transition_legend(@max_transition, @second_max_transition) %>
        <% if legend_data.any? %>
          <g transform="translate(700, -46)">
            <rect x="0" y="0" width="120" height="<%= legend_data.size * 25 + 40 %>" fill="white" stroke="#e2e8f0" stroke-width="2" rx="8" />
            
            <text x="55" y="22" font-size="12" font-weight="bold" fill="#64748b" text-anchor="middle">遷移回数</text>
            
            <% legend_data.each_with_index do |item, index| %>
              <g class="legend-item" data-marker-id="<%= item[:marker_id] %>" data-action="click->log-logic--state-transition#toggle">
                <rect x="15" y="<%= 35 + index * 25 %>" width="16" height="16" fill="<%= item[:color] %>" rx="4" />
                <text x="40" y="<%= 48 + index * 25 %>" font-size="13" fill="#333" font-weight="bold"><%= item[:text] %></text>
              </g>
            <% end %>
          </g>
        <% end %>
      </svg>
    </div>
  </div>

  <div class="row row-cols-1 row-cols-lg-2 g-4">
    
    <div class="col">
      <h5 class="fw-bold text-dark mb-3">状態数</h5>
      <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
          <thead class="table-light">
            <tr>
              <th scope="col">状態</th>
              <th scope="col">回数</th>
            </tr>
          </thead>
          <tbody>
            <% @patterns.each do |state, count| %>
              <tr>
                <td><%= state %></td>
                <td><%= count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="col">
      <h5 class="fw-bold text-dark mb-3">状態遷移図（データ）</h5>
      <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-nowrap">遷移元 ↓ / 遷移先 →</th>
              <% @states.each do |to_state| %>
                <th scope="col"><%= to_state %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @states.each do |from_state| %>
              <tr>
                <th scope="row" class="table-light"><%= from_state %></th>
                
                <% @states.each do |to_state| %>
                  <td>
                    <%= @transitions[[from_state, to_state]] %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<div
  class="offcanvas offcanvas-end"
  tabindex="-1"
  id="filterPanel"
>

  <div class="offcanvas-header">
    <h5>Filter</h5>

    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas">
    </button>
  </div>

  <div class="offcanvas-body">
    <%= form_with url: logs_state_transition_path,
                method: :get,
                local: true do %>
      <div class="card border-light mb-2">
        <div class="card-body py-2">

          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="fw-semibold text-secondary">Day</span>

            <div class="d-flex gap-1 flex-wrap">
              <% if params[:day_from].present? || params[:day_to].present? %>
                <span class="badge text-bg-secondary">
                  <%= short_date(params[:day_from]) %> ～ <%= short_date(params[:day_to]) %>
                </span>
              <% end %>

              <% if params[:recent].present? %>
                <span class="badge text-bg-secondary">
                  <%= params[:recent] %> 本
                </span>
              <% end %>
            </div>
          </div>

          <div class="row g-2 align-items-center">
            <div class="col-auto">
              <div class="d-flex align-items-center gap-1">
                <%= date_field_tag :day_from,
                      params[:day_from],
                      class: "form-control form-control-sm",
                      style: "width: 108px;" %>

                <span>～</span>

                <%= date_field_tag :day_to,
                      params[:day_to],
                      class: "form-control form-control-sm",
                      style: "width: 108px;" %>
              </div>
            </div>

            <div class="col-auto">
              <div class="input-group input-group-sm">
                <%= number_field_tag :recent,
                      params[:recent],
                      min: 1,
                      class: "form-control",
                      style: "width: 90px;" %>

                <span class="input-group-text">本</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <%= link_to "リセット", logs_state_transition_path, class: "btn btn-light border text-secondary" %>
        <%= submit_tag "絞り込み", class: "btn btn-primary", name: nil %>
      </div>
    <% end %>
  </div>
</div>
