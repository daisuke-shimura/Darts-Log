<div class="d-flex justify-content-center align-items-center h-100">
  <div class="darts-container" style="height: 100%; aspect-ratio: 1 / 1;">
    <svg viewBox="-250 -250 500 500" xmlns="http://www.w3.org/2000/svg">

      <use href="#icon-dartboard" x="-250" y="-250" width="500" height="500" />

      <g id="points-layer" transform="scale(1,-1)">
        <% @darts_data.each do |throw| %>
          <circle
            cx="<%= throw.x %>"
            cy="<%= throw.y %>"
            r="1"
            fill="<%= darts_number_color(throw) %>"
            fill-opacity="0.2"
          />
        <% end %>
      </g>
    </svg>
  </div>
</div>

<div class="position-absolute top-0 start-0 mt-3 ms-3">
  <p>検索結果：<%= @darts_data.count %>
  </p>
  <p>BULL合計：<%= bull_count(@darts_data) %></p>
  <p>
    <% if params[:targets].present? %>
      <% params[:targets].each do |target| %>
        <span><%= sement_count(@darts_data, target) %></span>
      <% end %>
    <% end %>
  </p>
  <p>
    <% if params[:numbers].present? %>
      <% params[:numbers].each do |number| %>
        <span><%= number %>投目：<%= bull_count_of_number(@darts_data, number) %>　</span>
      <% end %>
    <% end %>
  </p>
  <hr>
  <p>ダーツの総計：<%= @darts_all.count %></p>
  <h5>ターゲット</h5>
  <p>BULL：<%= @target_bull.count %>　20：<%= @target_20.count %></p>
  <h5>テーブル別</h5>
  <p>ROUND：<%= @record_rounds %>R（<%= @record_darts.count %>本）</p>
  <p>GAME：<%= @game %>（<%= @game_rounds %>R, <%= @game_darts.count %>本）</p>
  <h5>ゲーム別</h5>
  <p>01：<%= @zero_one_games %>（<%= @zero_one_darts.count %>本）　CRICKET：<%= @cricket_games %>（<%= @cricket_darts.count %>本）</p>
  <p>COUNT-UP：<%= @count_up_games %>（<%= @count_up_darts.count %>本）</p>
  <p>CENTER COUNT-UP：<%= @center_count_up_games %>（<%= @center_count_up_darts.count %>本）</p>
  <p>CRICKET COUNT-UP：<%= @cricket_count_up_games %>（<%= @cricket_count_up_darts.count %>本）</p>
  <p>SHOOT OUT：<%= @shoot_out_games %>（<%= @shoot_out_darts.count %>本）</p>
  <h5>投擲順</h5>
  <p>1投目：<%= @first_darts.count %>　2投目：<%= @second_darts.count %>　3投目：<%= @third_darts.count %></p>
</div>

<div class="position-absolute top-0 end-0 mt-3 me-3 ps-5 w-25">
  <%= form_with url: logs_path,
                method: :get,
                local: true do %>
    
    <div class="accordion w-100 mb-2" id="gameAccordion">
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingGame">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#collapseGame"
            aria-expanded="false"
            aria-controls="collapseGame"
          >
            <div class="d-flex align-items-center gap-2 flex-wrap w-100">
              <span class="text-nowrap">▼ Game</span>

              <% if @selected_kinds.present? %>
                <div class="d-flex gap-1 flex-wrap">
                  <% @selected_kinds.each_value do |game| %>
                    <span class="badge rounded-pill text-bg-<%= game[:color] %>">
                      <%= game[:label] %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </button>
        </h2>

        <div
          id="collapseGame"
          class="accordion-collapse collapse"
          aria-labelledby="headingGame"
          data-bs-parent="#gameAccordion"
        >

          <div class="accordion-body d-flex gap-2 flex-wrap w-100">

            <%= check_box_tag("kinds[]", "zero_one", params[:kinds]&.include?("zero_one"), class: "btn-check", id: "kind_zero_one") %>
            <%= label_tag("kind_zero_one", "01", class: "btn btn-outline-danger btn-sm") %>

            <%= check_box_tag("kinds[]", "cricket", params[:kinds]&.include?("cricket"), class: "btn-check", id: "kind_cricket") %>
            <%= label_tag("kind_cricket", "CRICKET", class: "btn btn-outline-primary btn-sm") %>

            <%= check_box_tag("kinds[]", "count_up", params[:kinds]&.include?("count_up"), class: "btn-check", id: "kind_count_up") %>
            <%= label_tag("kind_count_up", "COUNT-UP", class: "btn btn-outline-success btn-sm") %>

            <%= check_box_tag("kinds[]", "center_count_up", params[:kinds]&.include?("center_count_up"), class: "btn-check", id: "kind_center_count_up") %>
            <%= label_tag("kind_center_count_up", "CENTER COUNT-UP", class: "btn btn-outline-warning btn-sm") %>

            <%= check_box_tag("kinds[]", "cricket_count_up", params[:kinds]&.include?("cricket_count_up"), class: "btn-check", id: "kind_cricket_count_up") %>
            <%= label_tag("kind_cricket_count_up", "CRICKET COUNT-UP", class: "btn btn-outline-info btn-sm") %>

            <%= check_box_tag("kinds[]", "shoot_out", params[:kinds]&.include?("shoot_out"), class: "btn-check", id: "kind_shoot_out") %>
            <%= label_tag("kind_shoot_out", "SHOOT OUT", class: "btn btn-outline-dark btn-sm") %>

          </div>
        </div>
      </div>
    </div>

    <div class="d-grid mb-2">
      <%= check_box_tag(:record, "1", params[:record] == "1", class: "btn-check", id: "kind_record") %>
      <%= label_tag(:kind_record, "Record", class: "btn btn-outline-secondary btn-sm") %>
    </div>

    <div
      data-controller="log-logic--filter"
      data-log-logic--filter-targets-value='<%= (params[:targets] || []).to_json %>'
      data-log-logic--filter-colors-value='<%= (params[:colors] || []).to_json %>'
      data-log-logic--filter-numbers-value='<%= (params[:numbers] || []).to_json %>'
    >
      <div class="d-flex align-items-center mb-2">
        <select class="form-select w-auto form-select-sm" data-log-logic--filter-target="select">
          <% target_sort.each do |target| %>
            <option value="<%= target %>">
              <%= target.upcase %>
            </option>
          <% end %>
        </select>

        <input
          type="color"
          value="#ff0000"
          class="form-control form-control-color form-control-sm"
          data-log-logic--filter-target="color"
          list="color-palette"
          style="width: 30px; height: 30px;"
        >
        <datalist id="color-palette">
          <option value="#FF0000"></option> <!-- 赤 -->
          <option value="#FF6600"></option> <!-- オレンジ -->
          <option value="#FFCC00"></option> <!-- 黄色 -->
          <option value="#00CC00"></option> <!-- 緑 -->
          <option value="#00FFFF"></option> <!-- 水色 -->
          <option value="#0000FF"></option> <!-- 青 -->
          <option value="#9900FF"></option> <!-- 紫 -->
          <option value="#FF00FF"></option> <!-- ピンク -->
          <option value="#8B4513"></option> <!-- 茶色 -->
          <option value="#000000"></option> <!-- 黒 -->
        </datalist>

        <button type="button" class="btn btn-primary btn-sm ms-2" data-action="click->log-logic--filter#addTarget">
          Add
        </button>
      </div>

      <div class="d-flex gap-1 flex-wrap mb-2" data-log-logic--filter-target="tags"></div>
      <div data-log-logic--filter-target="hiddenInputs"></div>

      <div class="d-flex align-items-center mb-2">
        <select class="form-select w-auto form-select-sm" data-log-logic--filter-target="numberSelect">
          <option value="1">1投目</option>
          <option value="2">2投目</option>
          <option value="3">3投目</option>
        </select>

        <button type="button" class="btn btn-primary btn-sm ms-2" data-action="click->log-logic--filter#addNumber">
          Add
        </button>
      </div>

      <div class="d-flex gap-1 flex-wrap mb-3" data-log-logic--filter-target="numberTags"></div>
      <div data-log-logic--filter-target="numberHiddenInputs"></div>
    </div>

    <div class="card border-light mb-2">
      <div class="card-body py-2">

        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="fw-semibold text-secondary">Day</span>

          <div class="d-flex gap-1 flex-wrap">
            <% if params[:day_from].present? || params[:day_to].present? %>
              <span class="badge text-bg-secondary">
                <%= date_range(params[:day_from], params[:day_to]) %>
              </span>
            <% end %>

            <% if params[:recent].present? %>
              <span class="badge text-bg-secondary">
                <%= params[:recent] %> 本
              </span>
            <% end %>
          </div>
        </div>

        <div class="row g-2 align-items-center">
          <div class="col-auto">
            <div class="d-flex align-items-center gap-1">
              <%= date_field_tag :day_from,
                    params[:day_from],
                    class: "form-control form-control-sm",
                    style: "width: 108px;" %>

              <span>～</span>

              <%= date_field_tag :day_to,
                    params[:day_to],
                    class: "form-control form-control-sm",
                    style: "width: 108px;" %>
            </div>
          </div>

          <div class="col-auto">
            <div class="input-group input-group-sm">
              <%= number_field_tag :recent,
                    params[:recent],
                    min: 1,
                    class: "form-control",
                    style: "width: 90px;" %>

              <span class="input-group-text">本</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
      <%= link_to "リセット", logs_path, class: "btn btn-light border text-secondary" %>
      <%= submit_tag "絞り込み", class: "btn btn-primary", name: nil %>
    </div>
  <% end %>
</div>

<div class="p-3 h-100">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to "← 前月",
        logs_path(month: (@target_month - 1.month).strftime("%Y-%m-%d")),
        class: "btn btn-outline-secondary" %>

    <h4 class="mb-0">
      <%= @target_month.strftime("%Y年%-m月") %>
    </h4>

    <%= link_to "翌月 →",
        logs_path(month: (@target_month + 1.month).strftime("%Y-%m-%d")),
        class: "btn btn-outline-secondary" %>
  </div>

  <div class="calendar-grid">
    <div class="calendar-header text-danger">日</div>
    <div class="calendar-header">月</div>
    <div class="calendar-header">火</div>
    <div class="calendar-header">水</div>
    <div class="calendar-header">木</div>
    <div class="calendar-header">金</div>
    <div class="calendar-header text-primary">土</div>

    <% @calendar_dates.each do |date| %>
    <% darts = @daily_darts[date] || [] %>
      <% if darts.present? %>
        <% bull = bull_count(darts) %>
        <div class="calendar-day" style="<%= date_color(bull) %>">
          <div class="calendar-day-number <%= date_font_color(date) %>"><%= date_font(date, @target_month) %></div>
          <div class="pt-4 ps-1"><%= darts.count %>本</div>
          <div class="pt-1 ps-1">BULL数：<%= bull_count(darts) %>本</div>
          <div class="pt-1 ps-1">BULL率：<%= bull_late(darts, bull) %></div>
        </div>
      <% else %>
        <div class="calendar-day">
          <div class="calendar-day-number <%= date_font_color(date) %>"><%= date_font(date, @target_month) %></div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
