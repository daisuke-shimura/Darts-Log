<div class="position-relative bg-light" style="height: 100vh;">
  <div class="d-flex justify-content-center align-items-center h-100">
    <div class="darts-container" style="height: 100%; aspect-ratio: 1 / 1;">
      <svg viewBox="-250 -250 500 500" xmlns="http://www.w3.org/2000/svg">

        <use href="#icon-dartboard" x="-250" y="-250" width="500" height="500" />

        <g id="points-layer" transform="scale(1,-1)">
          <% if params[:targets].present? %>
            <% @target_groups.each do |group| %>
              <% group[:darts].each do |throw| %>
                <circle
                  cx="<%= throw.x %>"
                  cy="<%= throw.y %>"
                  r="1"
                  fill="<%= group[:color] %>"
                  fill-opacity="0.25"
                />
              <% end %>
            <% end %>
          <% else %>
            <% @darts_data.each do |throw| %>
              <circle
                cx="<%= throw.x %>"
                cy="<%= throw.y %>"
                r="1"
                fill="red"
                fill-opacity="0.25"
              />
            <% end %>
          <% end %>
        </g>
      </svg>
    </div>
  </div>

  <div class="position-absolute top-0 end-0 mt-3 me-3">
    <%= form_with url: logs_path,
                  method: :get,
                  local: true do %>
      
      <div>
        <%= check_box_tag(:record, "1", params[:record] == "1", class: "btn-check", id: "kind_record") %>
        <%= label_tag(:kind_record, "record", class: "btn btn-outline-secondary") %>
      </div>

      <div class="accordion" id="gameAccordion">
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingGame">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGame" aria-expanded="false" aria-controls="collapseGame">
              ▼ Game
            </button>
          </h2>
          <div id="collapseGame" class="accordion-collapse collapse" aria-labelledby="headingGame" data-bs-parent="#gameAccordion">
            <div class="accordion-body d-flex gap-3">
              <%= check_box_tag("kinds[]", "zero_one", params[:kinds]&.include?("zero_one"), class: "btn-check", id: "kind_zero_one") %>
              <%= label_tag("kind_zero_one", "01", class: "btn btn-outline-danger") %>

              <%= check_box_tag("kinds[]", "cricket", params[:kinds]&.include?("cricket"), class: "btn-check", id: "kind_cricket") %>
              <%= label_tag("kind_cricket", "CRICKET", class: "btn btn-outline-primary") %>

              <%= check_box_tag("kinds[]", "count_up", params[:kinds]&.include?("count_up"), class: "btn-check", id: "kind_count_up") %>
              <%= label_tag("kind_count_up", "COUNT-UP", class: "btn btn-outline-success") %>

              <%= check_box_tag("kinds[]", "center_count_up", params[:kinds]&.include?("center_count_up"), class: "btn-check", id: "kind_center_count_up") %>
              <%= label_tag("kind_center_count_up", "CENTER COUNT-UP", class: "btn btn-outline-warning") %>

              <%= check_box_tag("kinds[]", "cricket_count_up", params[:kinds]&.include?("cricket_count_up"), class: "btn-check", id: "kind_cricket_count_up") %>
              <%= label_tag("kind_cricket_count_up", "CRICKET COUNT-UP", class: "btn btn-outline-info") %>

              <%= check_box_tag("kinds[]", "shoot_out", params[:kinds]&.include?("shoot_out"), class: "btn-check", id: "kind_shoot_out") %>
              <%= label_tag("kind_shoot_out", "SHOOT OUT", class: "btn btn-outline-dark") %>
            </div>
          </div>
        </div>
      </div>

      <div
        data-controller="filter"
        data-filter-targets-value='<%= (params[:targets] || []).to_json %>'
        data-filter-colors-value='<%= (params[:colors] || []).to_json %>'
      >
        <div class="d-flex gap-2 align-items-center">

          <select class="form-select w-auto" data-filter-target="select">
            <% target_sort.each do |target| %>
              <option value="<%= target %>">
                <%= target.upcase %>
              </option>
            <% end %>
          </select>

          <input
            type="color"
            value="#ff0000"
            class="form-control form-control-color"
            data-filter-target="color"
          >

          <button
            type="button"
            class="btn btn-primary"
            data-action="click->filter#addTarget"
          >
            Add
          </button>

        </div>

        <div class="d-flex gap-2 flex-wrap mt-3" data-filter-target="tags"></div>
        <div data-filter-target="hiddenInputs"></div>
      </div>

      <%= submit_tag "絞り込み", class: "btn btn-primary" %>
      <%= link_to "リセット", logs_path, class: "btn btn-light border text-secondary" %>
    <% end %>
  </div>
</div>
