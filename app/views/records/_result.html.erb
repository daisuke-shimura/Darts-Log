<div id="fixedForm" data-controller="result" class="fixed-form">
  <div class="fixed-form-inner">
    <button class="target-display" data-bs-toggle="modal" data-bs-target="#targetModal">
      <input type="hidden" value="<%= @default_target %>" data-<%= js_controller %>-target="targetInput">
      <div class="target-label">TARGET</div>
      <div class="target-name" data-target-target="name" data-<%= js_controller %>-target="targetName"><%= @default_target_name %></div>
    </button>

    <ul class="result-list">
      <li data-<%= js_controller %>-target="resultItem">1投目：<span data-<%= js_controller %>-target="output" data-action="click-><%= js_controller %>#toggleBounce"></span></li>
      <li data-<%= js_controller %>-target="resultItem">2投目：<span data-<%= js_controller %>-target="output" data-action="click-><%= js_controller %>#toggleBounce"></span></li>
      <li data-<%= js_controller %>-target="resultItem">3投目：<span data-<%= js_controller %>-target="output" data-action="click-><%= js_controller %>#toggleBounce"></span></li>
    </ul>

    <%= render "records/flash-message" %>
    <button disabled class="cansel-btn btn btn-secondary rounded-pill" data-action="click-><%= js_controller %>#cancel" data-<%= js_controller %>-target="cancelBtn">
      キャンセル
    </button>
    <button disabled class="submit-btn btn btn-primary rounded-pill" data-action="click-><%= js_controller %>#submit" data-<%= js_controller %>-target="submitBtn">
      確定
    </button>
  </div>

  <% if controller_path.start_with?("games/") %>
    <% if controller_path == "games/crickets" %>
      <div class="cricket-box d-flex justify-content-between mt-1">
        <div class="number-box">
          <div class="cricket-label">20</div>
          <div class="cricket-label">19</div>
          <div class="cricket-label">18</div>
          <div class="cricket-label">17</div>
          <div class="cricket-label">16</div>
          <div class="cricket-label">15</div>
          <div class="cricket-label fs-6">BULL</div>
        </div>
        <div class="mark-box" data-<%= js_controller %>-target="marksBox">
          <% @current_segments_status.each do |number, mark| %>
            <div class="cricket-mark" data-cricketrow="<%= number %>">
              <%= cricket_mark(mark) %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="score-box mt-1" data-<%= js_controller %>-target="scoreBox">
        <%= @current_score %>
      </div>
      <% if controller_path == "games/shoot_outs" %>
        <div class="d-flex mt-1">
          <div class="bg-black text-white w-75 px-2 py-1 d-flex align-items-center">
            <div class="d-flex flex-column align-items-center lh-1 me-3 w-50">
              <span style="font-size: 0.8rem;">NEXT</span>
              <span class="fw-bold fs-6">×</span>
            </div>
            <span class="fw-bold lh-1 fs-3 w-50 text-center" data-<%= js_controller %>-target="currentRate"><%= @rate %></span>
          </div>
        </div>
        <div class="d-flex">
          <div
            class="d-grid text-center w-75 lh-1 bg-black text-white border-top"
            style="grid-template-columns: repeat(6, 1fr);
                   font-size: 0.8rem;">
            <% @closed_segments.flatten.each do |segment| %>
              <%= segemnt_status(segment, @current_segments_status[segment]) %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
